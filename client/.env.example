# URL Backend Server (Render.com)
# Contoh lokal: http://localhost:3001
# Contoh produksi di Render: https://nama-aplikasi-anda.onrender.com
VITE_SOCKET_URL=http://localhost:3001

# (Opsional) Konfigurasi PeerJS custom jika berbeda dari host Socket.io
# VITE_PEER_HOST=
# VITE_PEER_PORT=
# VITE_PEER_SECURE=true

# (Opsional) STUN/TURN server custom dalam format JSON array
# Contoh: [{"urls":"stun:stun.l.google.com:19302"}]
# VITE_ICE_SERVERS=
